<?xml version="1.0" encoding="utf-8"?>
<!-- Beberapa server CDN Steam (mis. alibaba.cdn.steampipe.steamcontent.com) memakai http biasa.
     Isi potongan data sudah dienkripsi (kunci depot) dan dicek SHA-1 oleh Steam.
     Sengaja memakai base-config (bukan domain-config): domain-config membuat Android mewajibkan
     pemeriksaan sertifikat "hostname aware" yang tidak didukung TLS milik Ktor (WebSocket login Steam). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
